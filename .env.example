# GLM standard API for application integration. The Coding Plan endpoint is
# restricted to supported coding tools and is rejected by this runtime.
MODEL_PROVIDER=glm
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.7-flash
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=240
MODEL_TEMPERATURE=0.2
MODEL_THINKING_ENABLED=false
MODEL_STREAMING=true
MODEL_RETRY_ATTEMPTS=1
MODEL_ENABLED=false
# Planning emits a small JSON decision. Keep its latency/cost budget separate from
# the final customer answer; DeepSeek thinking is disabled only for this stage.
MODEL_DECISION_TIMEOUT_SECONDS=15
MODEL_DECISION_MAX_OUTPUT_TOKENS=300
MODEL_DECISION_THINKING_ENABLED=false

# Local data and operational limits.
DATA_DIR=./data
RAG_TOP_K=3
RAG_MIN_SCORE=0.12
RAG_DIRECT_APPROVED_ANSWER=true
RAG_DIRECT_APPROVED_MIN_SCORE=0.6
MAX_INPUT_CHARS=2000
SESSION_HISTORY_LIMIT=6

# Required for evolution approval/rejection/rollback endpoints. Keep administrator
# authentication enabled unless this process is bound to the local machine only.
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_AUTH_REQUIRED=true
BOOTSTRAP_ADMIN_ID=local-admin

# Trusted upstream adapter authentication. Chat is closed when authentication is
# required but no bootstrap client key is configured.
AUTH_REQUIRED=true
BOOTSTRAP_TENANT_ID=local-appliance
BOOTSTRAP_CLIENT_ID=local-adapter
BOOTSTRAP_CLIENT_KEY=replace-with-another-long-random-secret
BOOTSTRAP_CLIENT_CAN_SUPPLY_ORDER_CONTEXT=false
SUBJECT_HASH_KEY=replace-with-a-stable-random-hmac-secret

# Local privacy retention limits.
MESSAGE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
MAX_REQUEST_BODY_BYTES=16384
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MIN_FREE_DISK_MB=1024

# Test/demo only. Never enable in a real customer channel. Mock mode takes
# precedence over MODEL_ENABLED so the orchestration can be tested offline.
MODEL_MOCK_MODE=false

# Taobao official customer-service channel. Keep disabled until the service-market
# robot qualification, Qimen route and a test shop are available.
TAOBAO_ENABLED=false
TAOBAO_AUTO_REPLY_ENABLED=false
# Production default: automatic channel replies are blocked unless a replayed,
# approved and active release policy selects the conversation.
RELEASE_GATE_REQUIRED=true
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_REDIRECT_URI=https://your-public-host.example/v1/integrations/taobao/oauth/callback
# URL-safe base64 of exactly 32 random bytes. Never commit the real value.
TAOBAO_CREDENTIAL_KEY=
TAOBAO_QIMEN_CUSTOMER_ID=
# Set true only after an authenticated test message reaches the callback.
TAOBAO_QIMEN_ROUTE_VERIFIED=false
# Both values are allocated by the Taobao data/robot platform, not invented locally.
TAOBAO_CHATROBOT_REQUEST_TOKEN=
TAOBAO_CHATROBOT_TENANT_ID=
TAOBAO_TOP_GATEWAY=https://eco.taobao.com/router/rest
TAOBAO_OAUTH_AUTHORIZE_URL=https://oauth.taobao.com/authorize
TAOBAO_OAUTH_TOKEN_URL=https://oauth.taobao.com/token
TAOBAO_CALLBACK_MAX_SKEW_SECONDS=600

# Durable outbound worker. Production defaults enqueue in the API request and
# dispatch from a leased worker. Keep synchronous dispatch for isolated tests only.
OUTBOX_WORKER_ENABLED=true
OUTBOX_SYNC_DISPATCH=false
OUTBOX_POLL_SECONDS=1
OUTBOX_LEASE_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300

# Durable human-handoff dispatch worker. Jobs are written in the same transaction
# as proposed handoffs, claimed with SQLite leases, and retried with backoff.
HANDOFF_DISPATCH_WORKER_ENABLED=true
HANDOFF_DISPATCH_POLL_SECONDS=2
HANDOFF_DISPATCH_LEASE_SECONDS=30
HANDOFF_DISPATCH_BATCH_SIZE=20
HANDOFF_DISPATCH_MAX_ATTEMPTS=5
HANDOFF_DISPATCH_RETRY_BASE_SECONDS=5
HANDOFF_DISPATCH_RETRY_MAX_SECONDS=300

# Encrypted disaster recovery archives. Put BACKUP_DIR on storage independent
# from DATA_DIR in production. The key is URL-safe base64 for exactly 32 bytes.
# Rotate with BACKUP_NEW_KEY_ID/BACKUP_NEW_ENCRYPTION_KEY only for backup-rekey.
BACKUP_DIR=./backups
BACKUP_KEY_ID=local-v1
BACKUP_ENCRYPTION_KEY=
BACKUP_NEW_KEY_ID=
BACKUP_NEW_ENCRYPTION_KEY=
